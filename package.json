{
  "name": "nahe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nahe-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nahe-db --remote",
    "db:seed:local": "wrangler d1 execute nahe-db --local --file=./db/seed.sql",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "admin:hash": "node scripts/hash-password.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "node scripts/e2e.mjs",
    "a11y": "node scripts/a11y.mjs",
    "e2e:tickets": "node scripts/e2e-tickets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  }
}
