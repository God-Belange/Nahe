{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nahe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nahe-db",
      // Remplacer par l'identifiant retourné par `npx wrangler d1 create nahe-db` (voir README).
      "database_id": "6f5e58a3-823b-495c-87bc-82d0123c0b53",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
